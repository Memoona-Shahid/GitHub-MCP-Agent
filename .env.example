# =============================================================================
# GitHub MCP Agent — copy this file to .env and fill in real values.
# Never commit .env.
# =============================================================================

# --- GitHub MCP Server -------------------------------------------------------
# Create a PAT at: https://github.com/settings/personal-access-tokens
# Recommended scopes: repo (or public_repo), read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# How to reach the official GitHub MCP Server:
#   docker  — launch ghcr.io/github/github-mcp-server over stdio (recommended)
#   remote  — GitHub-hosted MCP at GITHUB_MCP_REMOTE_URL (PAT in Authorization)
#   binary  — a locally built github-mcp-server executable
GITHUB_MCP_MODE=docker

# Docker image for local GitHub MCP Server
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server

# Remote MCP endpoint (used when GITHUB_MCP_MODE=remote)
GITHUB_MCP_REMOTE_URL=https://api.githubcopilot.com/mcp/

# Path to a local github-mcp-server binary (used when GITHUB_MCP_MODE=binary)
GITHUB_MCP_BINARY_PATH=

# Toolsets exposed to the LLM. Keep this focused so tool choice stays accurate.
# Default GitHub sets: context, repos, issues, pull_requests, users
# Extra useful for this agent: commits live under the repos toolset.
GITHUB_TOOLSETS=context,repos,issues,pull_requests,users

# Optional GitHub Enterprise host, e.g. https://github.mycompany.com
GITHUB_HOST=

# --- LLM (OpenAI-compatible tool calling) ------------------------------------
# Works with OpenAI, Azure OpenAI, Groq, OpenRouter, Ollama, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Max agent tool-call rounds per user question
AGENT_MAX_TURNS=12

# --- App ---------------------------------------------------------------------
LOG_LEVEL=INFO

# Optional default repository in owner/name form, e.g. octocat/Hello-World
DEFAULT_REPO=

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8000
